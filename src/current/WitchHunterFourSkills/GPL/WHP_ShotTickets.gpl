function WHP_HitEffects(agent Hunter, agent Target, integer Code)
declare
    integer Potency;
begin
    if ($WHP_IsHunter(Hunter) == FALSE) return;
    if ($WHP_Living(Target) == FALSE) return;
    Potency = #WHP_BurnBase;
    if (Code >= 8)
        begin
            Potency = #WHP_BurnUndead;
            Code -= 8;
        end
    else if (Code >= 4)
        begin
            Potency = #WHP_BurnRefined;
            Code -= 4;
        end
    if ((Code == 1) || (Code == 3))
        if ((Hunter's "Target" == Target) && (Hunter's "WHP_Quarry" == Target))
            begin
                $WHP_MarkHit(Hunter, Target);
                $WHP_SunderHit(Hunter, Target);
                $WHP_EmbersteelHit(Hunter, Target);
            end
    if (Code >= 2) $WHP_SilverPayloadHit(Hunter, Target, Potency);
end

function WHP_HunterDeath(agent Hunter)
declare
begin
    if ($WHP_IsHunter(Hunter) == FALSE) return;
    if ($CheckEffector(Hunter, "WHP_Ward")) $DeleteEffector(Hunter, "WHP_Ward");
    if ($HasAttribute("WHP_LifeEpoch", Hunter) == FALSE)
        $AddAttribute(Hunter, "WHP_LifeEpoch", "integer", 0);
    Hunter's "WHP_LifeEpoch" += 1;
    $WHP_ClearHunter(Hunter);
    if ($HasAttribute("WHP_Shot0Id", Hunter)) Hunter's "WHP_Shot0Id" = 0;
    if ($HasAttribute("WHP_Shot1Id", Hunter)) Hunter's "WHP_Shot1Id" = 0;
