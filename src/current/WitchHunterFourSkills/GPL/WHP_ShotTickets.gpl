function WHP_BoltReleased(agent Hunter, agent Target)
declare
    integer Shot, Slot, Epoch, Potency;
    boolean Silver;
begin
    if ($WHP_IsHunter(Hunter) == FALSE) return;
    if ($WHP_Living(Hunter) == FALSE) return;
    if ($WHP_Living(Target) == FALSE) return;
    Shot = 0;
    $WHP_ReleaseId(Shot, Hunter, Target);
    if (Shot <= 0) return;
    if ($WHP_FindShot(Hunter, Shot) >= 0) return;
    $WHP_SyncQuarry(Hunter, Hunter's "Target");
    if ($HasAttribute("WHP_Epoch", Hunter) == FALSE) return;
    Slot = $WHP_FreeShotSlot(Hunter);
    if (Slot < 0)
        begin
            // Catch concrete retirements since the pre-attack snapshot.
            $WHP_PruneRetiredShots(Hunter, Target, Shot);
            Slot = $WHP_FreeShotSlot(Hunter);
        end
    if (Slot < 0)
        begin
            $WHP_PayloadFull(Hunter, Target, Shot);
            return;
        end
    Epoch = -1;
    if ((Hunter's "WHP_Quarry" == Target) && (Hunter's "Target" == Target)) Epoch = Hunter's "WHP_Epoch";
    Potency = $WHP_ReleasePotency(Hunter, Target);
    Silver = FALSE;
    if ($WHP_HeroLevel(Hunter, 3))
      if ($CheckEffector(Hunter, "WHP_SilverCooldown") == FALSE)
        begin
            Silver = TRUE;
            $CreateEffector(Hunter, "WHP_SilverCooldown", 15000);
        end
    if (Slot == 0)
        begin
            if ($HasAttribute("WHP_Shot0Id", Hunter) == FALSE)
                begin
                    $AddAttribute(Hunter, "WHP_Shot0Id", "integer", Shot);
                    $AddAttribute(Hunter, "WHP_Shot0Epoch", "integer", Epoch);
                    $AddAttribute(Hunter, "WHP_Shot0Player", "integer", $GetUnitPlayerNumber(Hunter));
                    $AddAttribute(Hunter, "WHP_Shot0TargetPlayer", "integer", $GetUnitPlayerNumber(Target));
                    $AddAttribute(Hunter, "WHP_Shot0Target", "agentref", Target);
                    $AddAttribute(Hunter, "WHP_Shot0Silver", "boolean", Silver);
                    $AddAttribute(Hunter, "WHP_Shot0Life", "integer", Hunter's "WHP_LifeEpoch");
                end
            if ($HasAttribute("WHP_Shot0Potency", Hunter) == FALSE)
                $AddAttribute(Hunter, "WHP_Shot0Potency", "integer", #WHP_BurnBase);
            Hunter's "WHP_Shot0Potency" = Potency;
            Hunter's "WHP_Shot0Id" = Shot;
            Hunter's "WHP_Shot0Epoch" = Epoch;
            Hunter's "WHP_Shot0Player" = $GetUnitPlayerNumber(Hunter);
            Hunter's "WHP_Shot0TargetPlayer" = $GetUnitPlayerNumber(Target);
            Hunter's "WHP_Shot0Target" = Target;
            Hunter's "WHP_Shot0Silver" = Silver;
            Hunter's "WHP_Shot0Life" = Hunter's "WHP_LifeEpoch";
        end
    if (Slot == 1)
        begin
            if ($HasAttribute("WHP_Shot1Id", Hunter) == FALSE)
                begin
                    $AddAttribute(Hunter, "WHP_Shot1Id", "integer", Shot);
                    $AddAttribute(Hunter, "WHP_Shot1Epoch", "integer", Epoch);
                    $AddAttribute(Hunter, "WHP_Shot1Player", "integer", $GetUnitPlayerNumber(Hunter));
                    $AddAttribute(Hunter, "WHP_Shot1TargetPlayer", "integer", $GetUnitPlayerNumber(Target));
                    $AddAttribute(Hunter, "WHP_Shot1Target", "agentref", Target);
                    $AddAttribute(Hunter, "WHP_Shot1Silver", "boolean", Silver);
                    $AddAttribute(Hunter, "WHP_Shot1Life", "integer", Hunter's "WHP_LifeEpoch");
                end
            if ($HasAttribute("WHP_Shot1Potency", Hunter) == FALSE)
