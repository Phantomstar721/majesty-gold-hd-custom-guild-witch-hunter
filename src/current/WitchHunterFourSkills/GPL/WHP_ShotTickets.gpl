    if ($HasAttribute("WHP_Shot31Id", Hunter) == FALSE) return 31;
    if (Hunter's "WHP_Shot31Id" == 0) return 31;
    return -1;
end

function WHP_PruneShots(agent Hunter)
declare
    integer Snapshot, Shot, Pending;
begin
    if ($WHP_IsHunter(Hunter) == FALSE) return;
    // Consumption normally frees slots. A full store requests one native
    // read-only snapshot outside release/impact, never one scan per slot.
    if ($WHP_FreeShotSlot(Hunter) >= 0) return;
    Snapshot = 0;
    $WHP_BeginShotSnapshot(Snapshot, Hunter);
    if (Snapshot <= 0) return;
    if ($HasAttribute("WHP_Shot0Id", Hunter))
        if (Hunter's "WHP_Shot0Id" > 0)
            begin
                Shot = Hunter's "WHP_Shot0Id";
                Pending = -1;
                $WHP_ShotPending(Pending, Hunter, Shot, Snapshot);
                if (Pending == 0) Hunter's "WHP_Shot0Id" = 0;
            end
    if ($HasAttribute("WHP_Shot1Id", Hunter))
        if (Hunter's "WHP_Shot1Id" > 0)
            begin
                Shot = Hunter's "WHP_Shot1Id";
                Pending = -1;
                $WHP_ShotPending(Pending, Hunter, Shot, Snapshot);
                if (Pending == 0) Hunter's "WHP_Shot1Id" = 0;
            end
    if ($HasAttribute("WHP_Shot2Id", Hunter))
        if (Hunter's "WHP_Shot2Id" > 0)
            begin
                Shot = Hunter's "WHP_Shot2Id";
                Pending = -1;
                $WHP_ShotPending(Pending, Hunter, Shot, Snapshot);
                if (Pending == 0) Hunter's "WHP_Shot2Id" = 0;
            end
    if ($HasAttribute("WHP_Shot3Id", Hunter))
        if (Hunter's "WHP_Shot3Id" > 0)
            begin
                Shot = Hunter's "WHP_Shot3Id";
                Pending = -1;
                $WHP_ShotPending(Pending, Hunter, Shot, Snapshot);
                if (Pending == 0) Hunter's "WHP_Shot3Id" = 0;
            end
    if ($HasAttribute("WHP_Shot4Id", Hunter))
        if (Hunter's "WHP_Shot4Id" > 0)
            begin
