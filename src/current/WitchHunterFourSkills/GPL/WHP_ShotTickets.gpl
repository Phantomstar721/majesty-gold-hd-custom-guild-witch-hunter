function WHP_PruneRetiredShots(agent Hunter, agent Target, integer Shot)
declare
    integer OldShot, Retired;
begin
    if ($HasAttribute("WHP_Shot0Id", Hunter))
        if (Hunter's "WHP_Shot0Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot0Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot0Id" = 0;
            end
    if ($HasAttribute("WHP_Shot1Id", Hunter))
        if (Hunter's "WHP_Shot1Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot1Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot1Id" = 0;
            end
    if ($HasAttribute("WHP_Shot2Id", Hunter))
        if (Hunter's "WHP_Shot2Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot2Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot2Id" = 0;
            end
    if ($HasAttribute("WHP_Shot3Id", Hunter))
        if (Hunter's "WHP_Shot3Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot3Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot3Id" = 0;
            end
    if ($HasAttribute("WHP_Shot4Id", Hunter))
        if (Hunter's "WHP_Shot4Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot4Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot4Id" = 0;
            end
    if ($HasAttribute("WHP_Shot5Id", Hunter))
        if (Hunter's "WHP_Shot5Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot5Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot5Id" = 0;
            end
    if ($HasAttribute("WHP_Shot6Id", Hunter))
        if (Hunter's "WHP_Shot6Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot6Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot6Id" = 0;
            end
    if ($HasAttribute("WHP_Shot7Id", Hunter))
        if (Hunter's "WHP_Shot7Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot7Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot7Id" = 0;
            end
    if ($HasAttribute("WHP_Shot8Id", Hunter))
        if (Hunter's "WHP_Shot8Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot8Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot8Id" = 0;
            end
    if ($HasAttribute("WHP_Shot9Id", Hunter))
        if (Hunter's "WHP_Shot9Id" > 0)
            begin
                OldShot = Hunter's "WHP_Shot9Id";
                Retired = -1;
                $WHP_ShotRetired(Retired, Hunter, Target, Shot, OldShot);
                if (Retired == 1) Hunter's "WHP_Shot9Id" = 0;
            end
    if ($HasAttribute("WHP_Shot10Id", Hunter))
        if (Hunter's "WHP_Shot10Id" > 0)
            begin
