    if ($HasAttribute("WHP_Shot14Id", Hunter) == FALSE) return 14;
    if (Hunter's "WHP_Shot14Id" == 0) return 14;
    if ($HasAttribute("WHP_Shot15Id", Hunter) == FALSE) return 15;
    if (Hunter's "WHP_Shot15Id" == 0) return 15;
    if ($HasAttribute("WHP_Shot16Id", Hunter) == FALSE) return 16;
    if (Hunter's "WHP_Shot16Id" == 0) return 16;
    if ($HasAttribute("WHP_Shot17Id", Hunter) == FALSE) return 17;
    if (Hunter's "WHP_Shot17Id" == 0) return 17;
    if ($HasAttribute("WHP_Shot18Id", Hunter) == FALSE) return 18;
    if (Hunter's "WHP_Shot18Id" == 0) return 18;
