function WHP_TakeHit(agent Hunter, agent Target) is integer
declare
    integer Shot, Slot, Code;
begin
    if ($WHP_IsHunter(Hunter) == FALSE) return 0;
    if ($WHP_Living(Hunter) == FALSE) return 0;
    if (Hunter's "AttackType" == 1)
        begin
            if (Hunter's "Target" != Target) return 0;
            $WHP_SyncQuarry(Hunter, Target);
            return 1;
        end
    if ($HasAttribute("WHP_Epoch", Hunter) == FALSE) return 0;
    Shot = 0;
    $WHP_ImpactId(Shot, Hunter, Target);
    if (Shot <= 0) return 0;
    Slot = $WHP_FindShot(Hunter, Shot);
    if (Slot < 0) return 0;
    if (Slot == 0)
        if ($HasAttribute("WHP_Shot0Id", Hunter))
            if ((Hunter's "WHP_Shot0Id" == Shot) && (Hunter's "WHP_Shot0Target" == Target))
                begin
                    Hunter's "WHP_Shot0Id" = 0;
                    if (Hunter's "WHP_Shot0Life" != Hunter's "WHP_LifeEpoch") return 0;
                    if (Hunter's "WHP_Shot0Player" != $GetUnitPlayerNumber(Hunter)) return 0;
                    if (Hunter's "WHP_Shot0TargetPlayer" != $GetUnitPlayerNumber(Target)) return 0;
                    Code = 0;
                    if (Hunter's "WHP_Shot0Silver") Code = 2;
                    if (Code == 2)
                        if ($HasAttribute("WHP_Shot0Potency", Hunter))
                            begin
                                if (Hunter's "WHP_Shot0Potency" == #WHP_BurnUndead) Code += 8;
                                else if (Hunter's "WHP_Shot0Potency" == #WHP_BurnRefined) Code += 4;
                            end
                    if ((Hunter's "WHP_Shot0Epoch" == Hunter's "WHP_Epoch") &&
