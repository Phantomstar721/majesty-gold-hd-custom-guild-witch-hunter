// 32 serialized slots, full-ID search and free allocation. Never modulo overwrite.
function WHP_FindShot(agent Hunter, integer Shot) is integer
declare
begin
    if (Shot <= 0) return -1;
    if ($HasAttribute("WHP_Shot0Id", Hunter))
        if (Hunter's "WHP_Shot0Id" == Shot) return 0;
    if ($HasAttribute("WHP_Shot1Id", Hunter))
        if (Hunter's "WHP_Shot1Id" == Shot) return 1;
    if ($HasAttribute("WHP_Shot2Id", Hunter))
        if (Hunter's "WHP_Shot2Id" == Shot) return 2;
    if ($HasAttribute("WHP_Shot3Id", Hunter))
        if (Hunter's "WHP_Shot3Id" == Shot) return 3;
    if ($HasAttribute("WHP_Shot4Id", Hunter))
        if (Hunter's "WHP_Shot4Id" == Shot) return 4;
    if ($HasAttribute("WHP_Shot5Id", Hunter))
        if (Hunter's "WHP_Shot5Id" == Shot) return 5;
    if ($HasAttribute("WHP_Shot6Id", Hunter))
        if (Hunter's "WHP_Shot6Id" == Shot) return 6;
    if ($HasAttribute("WHP_Shot7Id", Hunter))
        if (Hunter's "WHP_Shot7Id" == Shot) return 7;
    if ($HasAttribute("WHP_Shot8Id", Hunter))
        if (Hunter's "WHP_Shot8Id" == Shot) return 8;
    if ($HasAttribute("WHP_Shot9Id", Hunter))
        if (Hunter's "WHP_Shot9Id" == Shot) return 9;
    if ($HasAttribute("WHP_Shot10Id", Hunter))
        if (Hunter's "WHP_Shot10Id" == Shot) return 10;
    if ($HasAttribute("WHP_Shot11Id", Hunter))
        if (Hunter's "WHP_Shot11Id" == Shot) return 11;
    if ($HasAttribute("WHP_Shot12Id", Hunter))
        if (Hunter's "WHP_Shot12Id" == Shot) return 12;
    if ($HasAttribute("WHP_Shot13Id", Hunter))
        if (Hunter's "WHP_Shot13Id" == Shot) return 13;
    if ($HasAttribute("WHP_Shot14Id", Hunter))
        if (Hunter's "WHP_Shot14Id" == Shot) return 14;
    if ($HasAttribute("WHP_Shot15Id", Hunter))
        if (Hunter's "WHP_Shot15Id" == Shot) return 15;
    if ($HasAttribute("WHP_Shot16Id", Hunter))
        if (Hunter's "WHP_Shot16Id" == Shot) return 16;
    if ($HasAttribute("WHP_Shot17Id", Hunter))
        if (Hunter's "WHP_Shot17Id" == Shot) return 17;
    if ($HasAttribute("WHP_Shot18Id", Hunter))
        if (Hunter's "WHP_Shot18Id" == Shot) return 18;
    if ($HasAttribute("WHP_Shot19Id", Hunter))
        if (Hunter's "WHP_Shot19Id" == Shot) return 19;
    if ($HasAttribute("WHP_Shot20Id", Hunter))
        if (Hunter's "WHP_Shot20Id" == Shot) return 20;
    if ($HasAttribute("WHP_Shot21Id", Hunter))
        if (Hunter's "WHP_Shot21Id" == Shot) return 21;
    if ($HasAttribute("WHP_Shot22Id", Hunter))
        if (Hunter's "WHP_Shot22Id" == Shot) return 22;
    if ($HasAttribute("WHP_Shot23Id", Hunter))
        if (Hunter's "WHP_Shot23Id" == Shot) return 23;
    if ($HasAttribute("WHP_Shot24Id", Hunter))
        if (Hunter's "WHP_Shot24Id" == Shot) return 24;
    if ($HasAttribute("WHP_Shot25Id", Hunter))
        if (Hunter's "WHP_Shot25Id" == Shot) return 25;
    if ($HasAttribute("WHP_Shot26Id", Hunter))
        if (Hunter's "WHP_Shot26Id" == Shot) return 26;
    if ($HasAttribute("WHP_Shot27Id", Hunter))
        if (Hunter's "WHP_Shot27Id" == Shot) return 27;
    if ($HasAttribute("WHP_Shot28Id", Hunter))
        if (Hunter's "WHP_Shot28Id" == Shot) return 28;
    if ($HasAttribute("WHP_Shot29Id", Hunter))
        if (Hunter's "WHP_Shot29Id" == Shot) return 29;
    if ($HasAttribute("WHP_Shot30Id", Hunter))
        if (Hunter's "WHP_Shot30Id" == Shot) return 30;
    if ($HasAttribute("WHP_Shot31Id", Hunter))
        if (Hunter's "WHP_Shot31Id" == Shot) return 31;
    return -1;
end

function WHP_FreeShotSlot(agent Hunter) is integer
declare
begin
    if ($HasAttribute("WHP_Shot0Id", Hunter) == FALSE) return 0;
