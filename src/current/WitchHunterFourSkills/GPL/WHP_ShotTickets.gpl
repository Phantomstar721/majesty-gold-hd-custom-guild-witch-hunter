    if ($HasAttribute("WHP_Shot20Id", Hunter) == FALSE) return 20;
    if (Hunter's "WHP_Shot20Id" == 0) return 20;
    if ($HasAttribute("WHP_Shot21Id", Hunter) == FALSE) return 21;
    if (Hunter's "WHP_Shot21Id" == 0) return 21;
    if ($HasAttribute("WHP_Shot22Id", Hunter) == FALSE) return 22;
    if (Hunter's "WHP_Shot22Id" == 0) return 22;
    if ($HasAttribute("WHP_Shot23Id", Hunter) == FALSE) return 23;
    if (Hunter's "WHP_Shot23Id" == 0) return 23;
    if ($HasAttribute("WHP_Shot24Id", Hunter) == FALSE) return 24;
    if (Hunter's "WHP_Shot24Id" == 0) return 24;
    if ($HasAttribute("WHP_Shot25Id", Hunter) == FALSE) return 25;
    if (Hunter's "WHP_Shot25Id" == 0) return 25;
    if ($HasAttribute("WHP_Shot26Id", Hunter) == FALSE) return 26;
    if (Hunter's "WHP_Shot26Id" == 0) return 26;
    if ($HasAttribute("WHP_Shot27Id", Hunter) == FALSE) return 27;
    if (Hunter's "WHP_Shot27Id" == 0) return 27;
