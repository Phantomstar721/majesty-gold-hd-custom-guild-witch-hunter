function gettoavoid(agent attacker, agent defender) is integer

declare
	integer value;
	boolean WHP_Ignored;
	agent AIRootAgent;

begin
	WHP_Ignored = $WHP_MarkActive(defender);
	if (attacker's "attacktype" == 1)
		begin
			value = $getattribute(defender,#ATTRIB_Parry);
		end
	else
		if (attacker's "attacktype" == 2)
			begin
				value = $getattribute(defender,#ATTRIB_Dodge);
			end
		else
			if (Attacker's "AttackType" == 5)
				begin
					value = $getattribute(defender,#ATTRIB_Dodge);
				end

	AIRootAgent = $RetrieveAgent ( "GplAIRoot" );
	if ( $HasAttribute ( "Deathmatch_Rules", AIRootAgent ))
		begin
			if ( AIRootAgent's "Deathmatch_Rules" == TRUE )
				begin
					if (value > #Deathmatch_max_toavoid)
						value = #Deathmatch_max_toavoid;
				end
			else
				begin
					if (value > #max_toavoid)
						value = #max_toavoid;
				end
		end
	else
		begin
			if (value > #max_toavoid)
				value = #max_toavoid;
		end

	return value;
end

///////////////////////////////////////////////////////////////////////////////

// stock.damage-contribution.v1: invocation-local adapters, no HP debit or roll.
function WHP_WeaponPreArmor(agent Attacker, agent Defender, integer Amount, integer State, boolean Critical) is integer
declare
begin
    return Amount + $WHP_SunhammerBonus(Attacker,Defender);
end

function WHP_WeaponBlocked(agent Attacker, agent Defender, integer Amount, integer State, boolean Critical) is integer
declare
begin
    return Amount - $WHP_InlayRecovery(Attacker,Defender,Amount);
end

function WHP_WeaponPercentReduce(agent Attacker, agent Defender, integer Amount, integer State, boolean Critical) is integer
declare
begin
    return $WHP_DamageWithFloor(Attacker,Defender,Amount,$WHP_BastionPercent(Attacker,Defender));
end

function WHP_SpellPercentReduce(agent Source, agent Attacker, agent Defender, integer Amount) is integer
declare
begin
    return $WHP_WardDamage(Defender,Amount);
end

function WHP_SpellDamageScale(agent Source, agent Attacker, agent Defender, integer Amount) is integer
declare
begin
    return $WHP_StatusDamage(Attacker, Defender, Amount, 0);
end
