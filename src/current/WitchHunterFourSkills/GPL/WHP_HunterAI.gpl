function WHP_HunterTree (agent thisagent)

declare

begin

	$createeffector(thisagent,"thought_bubble_think",#think_bubble_time);
	$SpecifyIntent (ThisAgent, #Intent_Thinking);

	if ($check_nearby(thisagent) == False)

	if ($Check_rewards(thisagent,FALSE) == False)

	if ($Defend_home(thisagent) == False)

	if ($defend_building(thisagent,"trading_post") == FALSE)

	if ($rest(thisagent) == False)

	if ($Purchase_equipment(thisagent) == False)

	if ($Purchase_bazaar(thisagent, 70) == False)

	if ($pursue_entertainment(thisagent) == False)


	if ($Hall_Champs_Check(thisagent, 40) == False)

	if ($WHP_Hunt(thisagent,75) == False)

	if ($explore_map(thisagent,95) == false)

	if ($combat_wandering_heroes(thisagent,55) == False)

// if ($Heal_another(thisagent,80) == False)


	if ($Go_home(thisagent,15) == False)

	if ($check_library(thisagent,15, "Train_magic_resist") == FALSE)

	// Approved weapon/passive identity: no offensive library-spell learning.

	if ($Raid_lair(thisagent,15) == False)

	if ($raid_enemy_building(thisagent,10) == False)

	if ($Visit_Building(ThisAgent, "Royal_gardens", 30) == False)

	if ($Visit_Building(ThisAgent, "Inn", 15) == False)
		begin
			$SpecifyIntent (ThisAgent, #intent_wandering);
			thisagent's "counter" = 0;
			thisagent's "activescript" = $hero_wander;
		end

end

function WHP_Hunt(agent thisagent, integer chance) is Boolean
//function WHP_Hunt(agent thisagent) is boolean
// this function,
// like all decision tree modules,
// must return a true or false value to indicate whether or not
// thisagent has decide to undertake the task

declare
	list wandering_monsters, leftover_monsters;
	integer current_best_score;
	agent current_best_monster;
	integer temp_score, local_intent;
	agent monster;

begin
//	$debugout("Should I combat wandering monsters?");
	if ($randomnumber(100) + 1 > chance) return FALSE;

	current_best_score = 0;

	$ListObjects(thisagent,"monster",-1, wandering_monsters,#NotMyTeam);

	//Init local intent to champion intent
	Local_intent = #Intent_Heeding_Champion_call;

	foreach monster in wandering_monsters do
		begin
			//Does the monster have a champion icon over them?
			If ($CheckEffector (Monster, "Champion_Icon"))
				begin
					//If yes, then target_eval them
					temp_score = $WHP_PreyScore(thisagent,monster);

					temp_score += #champs_mod;

					if (temp_score > current_best_score)
						begin
							current_best_score = temp_score;
							current_best_monster = monster;
						end

				end

			Else
				//Otherwise put the monster on the leftover_monsters list,
				//which is checked after the monsters with champion icons over them
				leftover_monsters << monster;

		end


	if (current_best_score <= 0)
		begin

			local_intent = #intent_hunting;

			foreach monster in leftover_monsters do
				begin
					temp_score = $WHP_PreyScore(thisagent,monster);


					if (temp_score > current_best_score)
						begin
							current_best_score = temp_score;
							current_best_monster = monster;
						end
				end

		end

	if (current_best_score > 0)
		begin
			thisagent's "activescript" = $Attack_object;
			thisagent's "target" = current_best_monster;

			$SpecifyIntent (ThisAgent, local_intent);

  //		$debugout("Yes");
			return TRUE;
		end

//	$debugout("No");
	return FALSE;

end

///////////////////////////////////////////////////////////////////////////////

function WHP_EvalNearby(agent thisagent) is Boolean

declare
	agent new_target,target;
	boolean flaggie;

begin

	$list_enemies(thisagent,1);

	if ($listsize(thisagent's "Hostiles") == 0) return FALSE;

	// add thisagent's target back onto the list, if neccessary????

	// decide whether to run or not
	if ($should_I_Run(thisagent,thisagent's "Hostiles") == FALSE)
		begin
			flaggie = FALSE; // thisagent does not have a new target

			target = thisagent's "target";
			new_target = $WHP_PickPrey(thisagent,thisagent's "Hostiles");

			// if thisagent's target is a building or lair,
			// they should just pick the closest enemy

			// if there is a target closer than thisagent's
			// current target - pick a new target
			if (($isvalidgamepiece(Target) == FALSE) || (Target == ThisAgent))
				flaggie = TRUE;
			else
				begin
					if ((target's "type" == "lair") || (target's "type" == "building"))
						flaggie = TRUE;
					if (($distanceBetweenAgents(thisagent,new_target) <
					$distanceBetweenAgents(thisagent,Target)))
						flaggie = TRUE;
				end

			if (flaggie)
				begin
					$stopmoving(thisagent);
					thisagent's "Target" = new_target;

					//Say See Hostile voice line if Target's "Type" is monster
					If (New_Target's "Type" == "Monster")
						$Say (ThisAgent, "VFX_See_Hostile");

					$SpecifyIntent (ThisAgent, #intent_fighting);
					thisagent's "ActiveScript" = $attack_object;
				end

			return Flaggie;
		end
	else
		begin
			// hero has decided to run!

			// empty thisagent's Hostiles list
			$clearlist(thisagent's "Hostiles");
			return TRUE;
		end
end

///////////////////////////////////////////////////////////////////////////////


// Bias only viable, currently seen prey; never turn a nonpositive evaluation positive.
function WHP_PreferredPrey(agent Hunter, agent Target) is boolean
declare
    list Seen;
begin
    if ($WHP_Living(Target) == FALSE) return FALSE;
    Seen = $List_Enemies_Seen(Hunter, $GetAttribute(Hunter, #ATTRIB_SightRange));
    if ($AgentInList(Target, Seen) == FALSE) return FALSE;
    if ($Target_Eval(Hunter, Target) <= 0) return FALSE;
    if ($WHP_IsUndead(Target)) return TRUE;
    // Stock Egetattackrange/gettargetrange distinguish heroes and monsters
    // from buildings/lairs before character-only combat queries.
    if ((Target's "Type" != "Hero") && (Target's "Type" != "Monster")) return FALSE;
    return $GetBestSpell(Target, #List_Attack) != "nothing";
end

function WHP_PreyScore(agent Hunter, agent Target) is integer
declare
    integer Score;
begin
    Score = $Target_Eval(Hunter, Target);
    if (Score > 0)
        if ($WHP_PreferredPrey(Hunter, Target)) Score += 5;
    return Score;
end

function WHP_PickPrey(agent Hunter, list Hostiles) is agent
declare
    list Preferred;
    agent Target;
begin
    foreach Target in Hostiles do
        if ($WHP_PreferredPrey(Hunter, Target)) Preferred << Target;
    if ($ListSize(Preferred) > 0) return $Pick_Closest(Hunter, Preferred);
    return $Pick_Closest(Hunter, Hostiles);
end
